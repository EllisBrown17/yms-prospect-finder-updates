+    headers={'Content-Type':'application/json','X-Goog-Api-Key':key,'X-Goog-FieldMask':'places.id,places.displayName,places.formattedAddress,places.websiteUri,places.nationalPhoneNumber,places.primaryTypeDisplayName'}
+    added_ids=[]; found=0; skipped=0; requests_used=0; ts=now_iso(); conn=db_conn()
