+.global-scan-bar{position:sticky;top:90px;z-index:34;margin:-2px 0 14px;border:1px solid rgba(198,255,0,.18);border-radius:14px;background:rgba(17,19,21,.96);backdrop-filter:blur(16px);box-shadow:0 12px 35px rgba(0,0,0,.22);overflow:hidden}.global-scan-main{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto auto;gap:11px;align-items:center;padding:10px 12px}.global-scan-copy{min-width:0}.global-scan-copy strong{display:block;font-size:10px;color:#eef0e9}.global-scan-copy small{display:block;margin-top:3px;color:#767b7f;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.global-scan-main>span:not(.live-dot),.global-scan-main>b{font-size:9px;font-variant-numeric:tabular-nums;color:#b7babd}.global-scan-main>b{color:var(--lime)}.global-scan-track{height:4px;background:#24272a}.global-scan-track i{display:block;height:100%;width:0;background:var(--lime);transition:width .35s ease;box-shadow:0 0 16px rgba(198,255,0,.35)}.global-scan-bar.done{border-color:rgba(198,255,0,.26)}.global-scan-bar.failed{border-color:rgba(255,107,107,.35)}.global-scan-bar.failed .global-scan-track i{background:#ff6b6b}.builder-save-error{color:#ff9d9d!important;border-color:rgba(255,107,107,.32)!important}.brand-reference{background:#0d0d0e;min-height:180px;object-fit:cover}.prospect-row,[data-lead]{cursor:pointer}.lead-table tbody tr[data-lead]:hover{background:rgba(198,255,0,.025)}
+@media(max-width:760px){.global-scan-bar{top:80px;margin-bottom:10px}.global-scan-main{grid-template-columns:auto minmax(0,1fr) auto auto}.global-scan-main .mini-action{display:none}.global-scan-copy small{max-width:52vw}}
