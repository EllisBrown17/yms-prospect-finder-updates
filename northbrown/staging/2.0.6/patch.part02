nt').textContent='100%'}return true}return false}catch(e){clearInterval(smartFinderPollHandle);$('#smartFinderBtn').disabled=false;$('#smartFinderBtn').innerHTML='Smart Finder — find &amp; scan <span>✦</span>';toast(e.message,true);return true}};const done=await tick();if(!done)smartFinderPollHandle=setInterval(tick,700)}
+$('#smartFinderBtn').onclick=async()=>{const b=$('#smartFinderBtn');const location=($('#smartFinderLocation').value||$('#discoverLocation').value||'').trim();b.disabled=true;b.textContent='Starting Smart Finder…';requestScanNotifications();const box=$('#smartFinderProgress');box.hidden=false;box.classList.remove('failed');$('#smartFinderFill').style.width='2%';$('#smartFinderPercent').textContent='0%';$('#smartFinderStage').textContent='Starting Smart Finder';$('#smartFinderDetail').textContent='Preparing local business searches…';$('#smartFinderCount').textContent='0 / 0';try{const r=await api('/api/smart-finder',{method:'POST',body:{location,radius_miles:+$('#smartFinderRadius').value,target:+$('#smartFinderTarget').value,mode:'smart'}});b.textContent='Finding local companies…';watchSmartFinder(r.job_id)}catch(e){box.classList.add('failed');toast(e.message,true);b.innerHTML='Smart Finder — find &amp; scan <span>✦</span>';b.disabled=false}};
 $('#addManualBtn').onclick=async()=>{try{await api('/api/leads',{method:'POST',body:{business_name:$('#manualName').value,website:$('#manualWebsite').value,email:$('#manualEmail').value,town:$('#manualTown').value,category:$('#manualCategory').value}});toast('Prospect added.');$('#manualModal').classList.remove('open');setView('prospects');await loadLeads();await loadOverview();}catch(e){toast(e.message,true)}};
 
 $('#importBtn').onclick=()=>$('#csvInput').click(); $('#csvInput').onchange=async e=>{const f=e.target.files[0];if(!f)return;const fd=new FormData();fd.append('file',f);try{const r=await api('/api/import',{method:'POST',body:fd});toast(`${r.imported} prospects imported.`);await loadLeads();await loadOverview();}catch(err){toast(err.message,true)}e.target.value=''};
