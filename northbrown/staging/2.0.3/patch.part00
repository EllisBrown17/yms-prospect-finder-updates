diff -ruN base202/payload/START_NORTHBROWN_INTERNAL.sh payload/START_NORTHBROWN_INTERNAL.sh
--- base202/payload/START_NORTHBROWN_INTERNAL.sh	2026-08-19 10:15:25.144765470 +0000
+++ payload/START_NORTHBROWN_INTERNAL.sh	2026-08-19 10:13:29.903391563 +0000
@@ -9,7 +9,7 @@
 refresh_app_icon() {
   local APP_BUNDLE="$HOME/Applications/NORTHBROWN Lead Engine.app"
   local ICON_SRC="$ROOT/NORTHBROWN_ICON.png"
-  local STAMP="$ROOT/.icon_ready_2_0_2"
+  local STAMP="$ROOT/.icon_ready_2_0_3"
   [ "$(uname -s 2>/dev/null || true)" = "Darwin" ] || return 0
   [ -d "$APP_BUNDLE" ] || return 0
   [ -f "$ICON_SRC" ] || return 0
@@ -41,7 +41,7 @@
 
 refresh_app_icon || true
 
-printf '\033[38;5;190mNORTHBROWN.\033[0m  Lead Engine 2.0 — Builder Edition · OTA READY\n\n'
+printf '\033[38;5;190mNORTHBROWN.\033[0m  Lead Engine 2.0.3 — Builder + Smart Finder · OTA READY\n\n'
 echo "Installed at: $ROOT" | tee -a "$LOG"
 
 if ! command -v python3 >/dev/null 2>&1; then
@@ -106,11 +106,18 @@
 PORT=${PORT:-5055}
 URL="http://127.0.0.1:${PORT}"
 
-# If an existing NORTHBROWN backend is already running, simply open it.
+# Reuse only a backend running the same version. If an older NORTHBROWN process is
+# still holding the port after an update, stop it so the new version actually starts.
 if curl -fsS "$URL/healthz" >/dev/null 2>&1; then
-  echo "NORTHBROWN is already running at $URL"
-  open "$URL"
-  exit 0
+  RUNNING_VERSION=$(curl -fsS "$URL/healthz" 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)
+  if [ "$RUNNING_VERSION" = "2.0.3" ]; then
+    echo "NORTHBROWN 2.0.3 is already running at $URL"
+    open "$URL"
+    exit 0
+  fi
+  OLD_PID=$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)
+  [ -n "$OLD_PID" ] && kill "$OLD_PID" >/dev/null 2>&1 || true
+  sleep 1
 fi
 
 echo
