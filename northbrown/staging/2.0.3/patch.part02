 .builder-preview-stage{min-width:0;display:flex;flex-direction:column;background:#080909;overflow:hidden}.builder-preview-head{height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 13px;border-bottom:1px solid rgba(255,255,255,.07);background:#0e1011}.builder-preview-head>div:first-child{display:flex;align-items:center;gap:7px}.builder-preview-head strong{font-size:8px;letter-spacing:.14em}.builder-preview-head small{color:#626764;font-size:8px}.builder-device-switch{display:flex;padding:3px;border:1px solid rgba(255,255,255,.07);border-radius:8px;background:#111315}.builder-device-switch button{border:0;background:transparent;color:#676c69;padding:5px 8px;border-radius:6px;font-size:8px;cursor:pointer}.builder-device-switch button.active{background:#222628;color:#e7e8e2}.builder-frame-shell{flex:1;min-height:0;display:flex;align-items:flex-start;justify-content:center;padding:18px;overflow:auto;background:repeating-conic-gradient(#101214 0 25%,#0d0f10 0 50%) 50%/18px 18px}.builder-frame-shell iframe{height:100%;min-height:620px;border:0;background:white;box-shadow:0 24px 80px rgba(0,0,0,.45);transition:.25s ease}.builder-frame-shell.desktop iframe{width:100%;max-width:1440px}.builder-frame-shell.tablet iframe{width:768px;max-width:100%}.builder-frame-shell.mobile iframe{width:390px;max-width:100%;border-radius:22px}.builder-saving{color:#f0c66c!important}.builder-save-error{color:#ff8b8b!important}
