:queued,'mode':mode})
+        if conn:
+            try: conn.close()
+            except Exception: pass
+
+
+@app.post('/api/smart-finder')
+def smart_finder():
+    data=request.get_json(silent=True) or {}
+    location=(data.get('location') or '').strip()
+    if not location:
+        return jsonify({'error':'Enter an area for Smart Finder.'}),400
+    target=max(10,min(200,int(data.get('target') or 100)))
+    radius=max(1,min(75,int(data.get('radius_miles') or 15)))
+    mode=(data.get('mode') or 'smart').lower()
+    if mode not in ('fast','smart','full'): mode='smart'
+    settings=get_settings(); key=(settings.get('google_places_api_key') or '').strip()
+    if not key:
+        return jsonify({'error':'Smart Finder needs your Google Places key in Settings. Website Builder Google maps/review links can still use the free Google mode.'}),400
+    categories=data.get('categories') if isinstance(data.get('categories'),list) else SMART_FINDER_CATEGORIES
+    categories=[str(x).strip() for x in categories if str(x).strip()][:30] or SMART_FINDER_CATEGORIES
+    job_id=f"finder-{int(time.time())}-{os.urandom(3).hex()}"
+    with SMART_FINDER_JOBS_LOCK:
+        SMART_FINDER_JOBS[job_id]={'job_id':job_id,'status':'finding','stage':'Starting Smart Finder','detail':f'Preparing {len(categories)} local business searches…','location':location,'radius_miles':radius,'target':target,'mode':mode,'total_categories':len(categories),'completed_categories':0,'current_category':'','found':0,'added':0,'skipped':0,'requests_used':0,'scan_job_id':None,'queued_for_scan':0,'started_at':now_iso(),'started_epoch':time.time()}
+    threading.Thread(target=_run_smart_finder_job,args=(job_id,location,target,radius,mode,categories,key),daemon=True).start()
+    return jsonify({'ok':True,'job_id':job_id,'status':'finding','total_categories':len(categories),'mode':mode})
+
+
+@app.get('/api/smart-finder-status/<job_id>')
+def smart_finder_status(job_id):
+    snap=_smart_finder_snapshot(job_id)
+    if not snap: return jsonify({'error':'Smart Finder job not found.'}),404
+    return jsonify(snap)
 
