+def _smart_finder_snapshot(job_id):
+    with SMART_FINDER_JOBS_LOCK:
+        job = SMART_FINDER_JOBS.get(job_id)
+        if not job:
+            return None
+        out = dict(job)
+    total = max(1, int(out.get('total_categories') or 1))
+    done = int(out.get('completed_categories') or 0)
+    out['percent'] = 100 if out.get('status') in ('scanning','complete') else round(min(99, done / total * 100), 1)
+    out['elapsed_seconds'] = max(0, int(time.time() - float(out.get('started_epoch') or time.time())))
+    return out
