 .brand-theme-presets{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.brand-theme-card{appearance:none;text-align:left;padding:11px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:#111315;color:var(--offwhite);cursor:pointer;transition:.18s ease}.brand-theme-card:hover{border-color:rgba(198,255,0,.24);transform:translateY(-1px)}.brand-theme-card.active{border-color:rgba(198,255,0,.48);box-shadow:inset 0 0 0 1px rgba(198,255,0,.09);background:rgba(198,255,0,.045)}.brand-theme-card b{display:block;font-size:10px}.brand-theme-card small{display:block;margin-top:3px;color:#74797d;font-size:7.5px;line-height:1.4}.brand-theme-card.northbrown-theme b{color:var(--lime)}
 .scan-head-actions{display:flex;align-items:flex-start;gap:8px}.scan-collapse,.scan-dismiss{width:30px;height:30px;border-radius:9px;border:1px solid rgba(255,255,255,.08);background:#151719;color:#aeb2b4;cursor:pointer;font-size:15px;line-height:1}.scan-collapse:hover,.scan-dismiss:hover{border-color:rgba(198,255,0,.28);color:var(--lime)}.scan-progress-panel.collapsed{width:min(430px,calc(100vw - 32px));padding-bottom:14px}.scan-progress-panel.collapsed .scan-live-card,.scan-progress-panel.collapsed .scan-counters,.scan-progress-panel.collapsed .scan-cost-line,.scan-progress-panel.collapsed .scan-summary,.scan-progress-panel.collapsed .scan-controls,.scan-progress-panel.collapsed .scan-activity-log{display:none!important}.scan-progress-panel.collapsed .scan-progress-track{margin-top:12px}.scan-progress-panel.collapsed .scan-progress-meta{margin-bottom:0}
