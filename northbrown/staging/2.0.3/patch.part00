+def _smart_finder_unsuitable(name):
+    low=(name or '').lower()
+    return any(token in low for token in SMART_FINDER_CHAIN_TOKENS)
+
+def _start_specific_scan(lead_ids, mode='smart'):
+    ids=[]
+    for value in lead_ids:
+        try:
+            i=int(value)
+            if i not in ids: ids.append(i)
+        except Exception:
+            pass
+    if not ids:
+        return None,0
+    conn=db_conn(); marks=','.join('?' for _ in ids)
+    rows=conn.execute(f"SELECT id,business_name FROM leads WHERE id IN ({marks}) AND website IS NOT NULL AND trim(website)<>''",ids).fetchall()
+    if not rows:
+        conn.close(); return None,0
+    job_id=f"scan-{int(time.time())}-{os.urandom(3).hex()}"; ts=now_iso()
+    conn.execute('INSERT INTO scan_jobs_persist(job_id,status,mode,total,started_at,started_at_epoch,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?)',(job_id,'running',mode,len(rows),ts,time.time(),ts,ts))
+    for pos,r in enumerate(rows,1):
+        conn.execute('INSERT INTO scan_queue(job_id,lead_id,position,status) VALUES(?,?,?,?)',(job_id,r['id'],pos,'pending'))
+    conn.commit(); conn.close(); _start_scan_worker(job_id)
+    return job_id,len(rows)
+
