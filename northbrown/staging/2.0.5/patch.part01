t=? WHERE id=?',(json.dumps(content),now_iso(),project_id)); conn.commit(); row=conn.execute('SELECT * FROM site_projects WHERE id=?',(project_id,)).fetchone(); conn.close(); out=_project_dict(row); out['_ai_used']=ai_used; out['_ai_warning']=warning; return jsonify(out)
 
