--- payload/static/app.css
+++ payload/static/app.css
@@ -50,3 +50,6 @@
 
 /* NORTHBROWN 2.0.3 QoL */
 .scan-head-actions{display:flex;align-items:flex-start;gap:10px}.scan-dismiss{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#17191b;color:#f0efea;font-size:22px;line-height:1;cursor:pointer}.scan-dismiss:hover{border-color:#c6ff00;color:#c6ff00}.smart-finder-box{margin-top:18px;padding:18px;border:1px solid rgba(198,255,0,.25);border-radius:18px;background:rgba(198,255,0,.035)}.smart-finder-box h3{margin:6px 0 6px}.smart-finder-box p,.finder-note{color:var(--muted);font-size:12px;line-height:1.5}.smart-finder-box .finder-note{display:block;margin-top:10px}.free-google-box{margin-top:14px;padding:16px;border:1px solid rgba(198,255,0,.22);border-radius:16px;background:rgba(198,255,0,.03)}.free-google-box>div{display:flex;flex-direction:column;gap:4px;margin-bottom:12px}.free-google-box small{color:var(--muted);line-height:1.45}@media(max-width:700px){.scan-head-actions{flex-direction:column;align-items:flex-end}.smart-finder-box .two-col{grid-template-columns:1fr}}
+
+/* NORTHBROWN 2.0.4 final polish — brand themes + collapsible Scan Intelligence */
+.brand-theme-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.brand-theme-choice{display:grid;grid-template-columns:20px 1fr;grid-template-rows:auto auto;column-gap:9px;align-items:center;text-align:left;padding:10px;border:1px solid rgba(255,255,255,.07);border-radius:11px;background:#141617;color:#e8e9e3;cursor:pointer;transition:.18s}.brand-theme-choice:hover{border-color:rgba(198,255,0,.28);transform:translateY(-1px)}.brand-theme-choice .theme-dot{grid-row:1/3;width:18px;height:18px;border-radius:50%;box-shadow:0 0 0 3px rgba(255,255,255,.04)}.theme-dot.business{background:linear-gradient(135deg,#c7a46a 0 50%,#232526 50%)}.theme-dot.category{background:linear-gradient(135deg,#6e8fbe,#c57b54)}.theme-dot.northbrown{background:#c6ff00}.theme-dot.light{background:#f5f4ef;border:1px solid #bfc1bd}.brand-theme-choice b{font-size:9px}.brand-theme-choice small{font-size:7px;color:#6c716e;margin-top:2px}.brand-theme-status{margin-top:9px;padding:8px 9px;border-radius:9px;background:#0f1112;border:1px solid rgba(255,255,255,.055);color:#777d79;font-size:8px}.brand-theme-board{margin-top:20px;padding:18px;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:linear-gradient(145deg,#111315,#0d0e0f);box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}.brand-theme-logo{display:flex;align-items:center;gap:13px}.brand-theme-logo img{width:58px;height:58px;border-radius:14px;border:1px solid rgba(255,255,255,.08)}.brand-theme-logo strong{display:block;font:700 15px Manrope,sans-serif;letter-spacing:.08em;color:#f0efea}.brand-theme-logo small{display:block;margin-top:4px;color:#6d716e;font-size:7px;letter-spacing:.2em}.brand-theme-swatch-row{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:18px 0 12px}.brand-theme-swatch-row .swatch{height:32px;border-radius:9px;border:1px solid rgba(255,255,255,.07)}.swatch.charcoal{background:#0d0d0e}.swatch.surface{background:#191b1d}.swatch.offwhite{background:#f0efea}.swatch.lime{background:#c6ff00}.brand-theme-copy b{display:block;font-size:9px;color:#dfe1da}.brand-theme-copy small{display:block;margin-top:4px;color:#6f7470;font-size:8px;line-height:1.45}.scan-collapse{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#17191b;color:#f0efea;font-size:18px;line-height:1;cursor:pointer}.scan-collapse:hover{border-color:#c6ff00;color:#c6ff00}.scan-progress-panel.collapsed{width:min(560px,calc(100vw - 36px));padding-bottom:14px}.scan-progress-panel.collapsed .scan-live-card,.scan-progress-panel.collapsed .scan-counters,.scan-progress-panel.collapsed .scan-cost-line,.scan-progress-panel.collapsed .scan-summary,.scan-progress-panel.collapsed .scan-controls,.scan-progress-panel.collapsed .scan-activity-log,.scan-progress-panel.collapsed .scan-progress-meta{display:none!important}.scan-progress-panel.collapsed .scan-progress-head{margin-bottom:10px}.scan-progress-panel.collapsed .scan-progress-track{margin-bottom:0}.scan-progress-panel.collapsed #scanProgressTitle{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:inline-block;vertical-align:middle}.scan-progress-panel.collapsed .scan-time-grid{display:flex;gap:6px}.scan-progress-panel.collapsed .scan-timer{min-width:62px;padding:6px 8px}.scan-progress-panel.collapsed .scan-timer small{font-size:6px}.scan-progress-panel.collapsed .scan-timer strong{font-size:10px}@media(max-width:700px){.brand-theme-actions{grid-template-columns:1fr}.scan-progress-panel.collapsed .scan-time-grid{display:none}.scan-progress-panel.collapsed #scanProgressTitle{max-width:190px}}
--- payload/static/app.js
+++ payload/static/app.js
@@ -70,8 +70,15 @@
 let scanClockHandle=null, scanPollHandle=null, scanLocalStarted=0, currentScanJob=null, scanActivityOpen=false, notifiedJobs=new Set();
 function fmtElapsed(seconds){seconds=Math.max(0,Math.floor(Number(seconds)||0));const h=Math.floor(seconds/3600),m=Math.floor((seconds%3600)/60),sec=seconds%60;return h?`${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`:`${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`}
 function requestScanNotifications(){try{if('Notification'in window&&Notification.permission==='default')Notification.requestPermission()}catch{}}
+function setScanCollapsed(collapsed){
+  const panel=$('#scanProgressPanel'),btn=$('#scanCollapseBtn');if(!panel)return;
+  panel.classList.toggle('collapsed',!!collapsed);
+  if(btn){btn.textContent=collapsed?'＋':'−';btn.title=collapsed?'Expand Scan Intelligence':'Collapse Scan Intelligence';btn.setAttribute('aria-expanded',collapsed?'false':'true')}
+  try{localStorage.setItem('northbrown_scan_collapsed',collapsed?'1':'0')}catch{}
+}
 function openScanProgress({title='Scanning websites…',total=0,current='',mode='smart'}={}){
   const panel=$('#scanProgressPanel');if(!panel)return;panel.classList.add('show');panel.classList.remove('complete','failed');
+  let collapsed=false;try{collapsed=localStorage.getItem('northbrown_scan_collapsed')==='1'}catch{}setScanCollapsed(collapsed);
   $('#scanProgressTitle').textContent=title;$('#scanProgressCount').textContent=total?`0 / ${total}`:'Preparing…';$('#scanProgressPercent').textContent='0%';$('#scanProgressFill').style.width='0%';$('#scanCurrentBusiness').textContent=current||'Preparing first website…';$('#scanElapsed').textContent='00:00';$('#scanEta').textContent='—';$('#scanModeBadge').textContent=String(mode||'smart').toUpperCase();$('#scanPhaseDetail').textContent='Getting the audit ready…';$('#scanFinding').textContent='NORTHBROWN will surface useful findings here as they are discovered.';$('#scanSummary').hidden=true;
